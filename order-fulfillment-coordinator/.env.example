# ═══════════════════════════════════════════════════════
# FulfillOS — Environment Variables
# ═══════════════════════════════════════════════════════
# Copy to .env and fill all values before deploying.
#
# ORACLE CLOUD (OCI) DEPLOYMENT:
#   scp .env user@host:/opt/fulfillment/.env
#   ./infra/scripts/deploy.sh
# ═══════════════════════════════════════════════════════

# ── Application ──────────────────────────────────────
APP_NAME=FulfillOS
APP_VERSION=0.1.0
DEBUG=false

# ── Database ─────────────────────────────────────────
# Production: PostgreSQL via docker-compose
DATABASE_URL=postgresql+asyncpg://fulfillment:YOUR_PASSWORD@postgres:5432/fulfillment
DATABASE_SYNC_URL=postgresql://fulfillment:YOUR_PASSWORD@postgres:5432/fulfillment

# ── PostgreSQL (for docker-compose.prod.yml) ─────────
POSTGRES_DB=fulfillment
POSTGRES_USER=fulfillment
POSTGRES_PASSWORD=CHANGE_ME_GENERATE_RANDOM_32

# ── Redis ────────────────────────────────────────────
REDIS_URL=redis://redis:6379/0
CELERY_BROKER_URL=redis://redis:6379/0
CELERY_RESULT_BACKEND=redis://redis:6379/0

# ── JWT Authentication ───────────────────────────────
JWT_SECRET=CHANGE_ME_generate_with_openssl_rand_64
JWT_ALGORITHM=HS256
JWT_EXPIRATION_MINUTES=60
JWT_REFRESH_EXPIRATION_DAYS=7
JWT_PASSWORD_RESET_EXPIRATION_MINUTES=30

# ── Webhooks ─────────────────────────────────────────
# Used to sign/verify inbound webhook payloads. REQUIRED in production:
# without it, signature verification is disabled (fail-open).
WEBHOOK_SECRET=CHANGE_ME_generate_with_openssl_rand_64

# ── CORS ─────────────────────────────────────────────
# Comma-separated list of allowed origins
CORS_ORIGINS=https://fulfillment.yourdomain.com

# ── OpenAI / AI Provider ─────────────────────────────
OPENAI_API_KEY=sk-...
OPENAI_BASE_URL=
OPENAI_MODEL=gpt-4o-mini

# ── Vector Search (Qdrant) ──────────────────────────
QDRANT_URL=http://localhost:6333
QDRANT_API_KEY=

# ── Shipping APIs ────────────────────────────────────
EASYPOST_API_KEY=EZ...
SMARTYSTREETS_AUTH_ID=...
SMARTYSTREETS_AUTH_TOKEN=...

# ── Notifications ────────────────────────────────────
TWILIO_ACCOUNT_SID=AC...
TWILIO_AUTH_TOKEN=...
TWILIO_PHONE_NUMBER=+1...
SENDGRID_API_KEY=SG...
SENDGRID_FROM_EMAIL=noreply@fulfillment.com

# ── Odoo ERP Integration ─────────────────────────────
ODOO_URL=
ODOO_DB=
ODOO_USERNAME=
ODOO_PASSWORD=
ODOO_VERIFY_SSL=true

# Fernet key used to encrypt/decrypt stored integration credentials
# (e.g. Odoo API keys). Generate with:
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# REQUIRED in production — without it, stored integration secrets cannot be read.
INTEGRATION_SECRET_KEY=CHANGE_ME_base64_urlsafe_44_chars=

# ── Frontend (for docker-compose.prod.yml) ───────────
FRONTEND_URL=https://fulfillment.yourdomain.com
DOMAIN=fulfillment.yourdomain.com
SSL_EMAIL=admin@yourdomain.com

# Backend base URL reachable from the frontend container (default: api:8000)
BACKEND_URL=http://api:8000

# Password-reset emails link back here (must be the public frontend URL)
RESET_EMAIL_REDIRECT_URL=https://fulfillment.yourdomain.com
