{
    # IP URL clients normally omit SNI; Docker sees its internal address.
    default_sni 140.245.218.97
}

# A trusted IP certificate terminates TLS before redirecting to the canonical
# hostname. This preserves one NextAuth cookie/CSRF origin, not two auth sites.
https://140.245.218.97 {
    tls {
        issuer acme {
            dir https://acme-v02.api.letsencrypt.org/directory
            profile shortlived
        }
    }
    redir https://{$DOMAIN}{uri} 308
}

http://140.245.218.97 {
    redir https://{$DOMAIN}{uri} 308
}

# ── Domain-based routing ────────────────────────────────
{$DOMAIN:localhost} {

    # Cookie-based profile requests need NextAuth's server-side token bridge.
    @frontend_profile {
        path /api/auth/me
        not header Authorization *
    }
    handle @frontend_profile {
        reverse_proxy frontend:3000
    }

    # Preserve frontend-owned NextAuth and chat/AI handlers.
    @frontend_api path /api/auth/session /api/auth/csrf /api/auth/providers /api/auth/signin* /api/auth/signout* /api/auth/callback/* /api/auth/error /api/chat /api/ai/*
    handle @frontend_api {
        reverse_proxy frontend:3000
    }

    # FastAPI owns these namespaces and explicit authentication operations.
    @backend_api path /api/v1/* /api/chat/* /api/demo/* /api/auth/login /api/auth/register /api/auth/refresh /api/auth/logout /api/auth/me /api/auth/change-password /api/auth/forgot-password /api/auth/reset-password /api/auth/users
    handle @backend_api {
        reverse_proxy api:8000
    }

    # Health
    handle /health {
        reverse_proxy api:8000
    }

    # WebSocket
    handle /ws/* {
        reverse_proxy api:8000
    }

    # Frontend — everything else
    handle {
        reverse_proxy frontend:3000
    }

    # Security headers
    header {
        X-Content-Type-Options "nosniff"
        X-Frame-Options "DENY"
        X-XSS-Protection "1; mode=block"
        Referrer-Policy "strict-origin-when-cross-origin"
        Permissions-Policy "camera=(), microphone=(), geolocation=()"
    }
}

# Caddy manages certificates and HTTP redirects automatically for DOMAIN.
